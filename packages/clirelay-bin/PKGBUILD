# Maintainer: xihale
# Binary repack of CliRelay (fork of router-for-me/CLIProxyAPI)
pkgname=clirelay-bin
pkgver=0.4.25
pkgrel=1
pkgdesc="Proxy server providing OpenAI/Gemini/Claude/Codex compatible API interfaces (CliRelay fork)"
arch=(x86_64 aarch64)
url="https://github.com/kittors/CliRelay"
license=(MIT)
depends=(glibc)
provides=(clirelay)
conflicts=(clirelay cli-proxy-api cli-proxy-api-bin)
install=clirelay-bin.install
source=(clirelay.service)
sha256sums=('2c62e577cb0023c3fe19c9ead81eeb67eb49572c511514295582c6a5f0b2e59c')
source_x86_64=("CliRelay-${pkgver}-x86_64.tar.gz::https://github.com/kittors/CliRelay/releases/download/v${pkgver}/CliRelay_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("CliRelay-${pkgver}-aarch64.tar.gz::https://github.com/kittors/CliRelay/releases/download/v${pkgver}/CliRelay_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('7fdc5810cb4361f132187b7824062f63250bbd705c44ed38a7d90540859416f8')
sha256sums_aarch64=('46499529a798e962829e3c4472d4ede67f9f953dde2f7a5e30e9d67401c786bb')

package() {
    install -Dm755 "${srcdir}/cli-proxy-api" "${pkgdir}/usr/bin/clirelay"

    install -Dm644 "${srcdir}/config.example.yaml" "${pkgdir}/usr/share/doc/${pkgname}/config.example.yaml"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    install -Dm644 "${srcdir}/clirelay.service" "${pkgdir}/usr/lib/systemd/user/clirelay.service"
}
