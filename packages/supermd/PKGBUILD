pkgname=supermd
pkgver=0
pkgrel=0
pkgdesc="SuperMD is an extension of Markdown used by https://zine-ssg.io"
arch=("any")
license=('MIT')
url="https://github.com/kristoff-it/supermd"

source=("git+https://github.com/kristoff-it/supermd.git")
sha256sums=('SKIP')

prepare() {
  if ! command -v zig >/dev/null; then
    echo "please install zig first!"
    exit 1
  fi

  # zig_version=$(zig version)
  # required_prefix="0.14"
  #
  # version=$(echo "$zig_version" | awk -F'[-+]' '{print $1}')
  #
  # if ! echo "$version" | grep -q "^$required_prefix\."; then
  #   echo -e "\033[31merror: Zig version $zig_version does not match $required_prefix.*"
  #   exit 1
  # fi
}

build() {
  cd "$srcdir/$pkgname"
  echo "Building..."
  zig build --release=safe
}

package() {
  install -Dm755 $srcdir/$pkgname/zig-out/bin/$pkgname $pkgdir/usr/bin/$pkgname
}
