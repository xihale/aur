pkgname=(gcc16 gcc16-libs gcc16-fortran)
pkgver=16.1.0
_commit=6afcc4f6da931eb93f3ab001a0dd9650ea71d1da
pkgrel=1
pkgdesc='The GNU Compiler Collection (16.x.x)'
arch=(x86_64)
license=(
  'GPL-3.0-or-later WITH GCC-exception-3.1'
  GFDL-1.3-or-later
)
url='https://gcc.gnu.org'
makedepends=(
  binutils
  doxygen
  git
  libisl
  libmpc
  python
  zstd
)
checkdepends=(
  dejagnu
  expect
  inetutils
  python-pytest
  tcl
)
options=(!emptydirs !lto)
_libdir=usr/lib/gcc/$CHOST/${pkgver%%+*}


source=("gcc16::git+https://github.com/gcc-mirror/gcc.git#tag=releases/gcc-16.1.0"
        c89 c99
)
sha256sums=('SKIP'
            '56361d1a1f721711d2f811ff72325fde2096b55850f9834dd1d745df2aecb010'
            '3105c4010a0cbd94ebe37479e8b6b1c7097c7281ef24b5e00048cdb8ce959876')
b2sums=('SKIP'
        'dea1c4efc58a5a9623632d0e7c8232570b8da0bc43eda8afc628841fb1435cd24e75e3b75b2a23b3f4879dd98541f5a4c684331639e29c606ed44819a50dfccc'
        'fbf9d7778dc709046a61a9a32612532f2b457e02fd81ff98034091d38f171dd1730f83e02683fbee081bed2d56c40fc83dc7631f7baa67412ab451b40b8215ab')

prepare() {
  cd gcc16

  # Do not run fixincludes
  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in

  # Arch Linux installs x86_64 libraries /lib
  sed -i '/m64=/s/lib64/lib/' gcc/config/i386/t-linux64
  sed -i '/lp64=/s/lib64/lib/' gcc/config/aarch64/t-aarch64-linux
  mkdir -p "$srcdir/gcc-build"
}

build() {
  local _confflags=(
      --prefix=/usr
      --libdir=/usr/lib
      --libexecdir=/usr/lib
      --mandir=/usr/share/man
      --infodir=/usr/share/info
      --with-bugurl=https://gitlab.archlinux.org/archlinux/packaging/packages/gcc16/-/issues
      --with-linker-hash-style=gnu
      --with-system-zlib
      --enable-__cxa_atexit
      --enable-cet=auto
      --enable-checking=release
      --enable-clocale=gnu
      --enable-default-pie
      --enable-default-ssp
      --enable-gnu-indirect-function
      --enable-gnu-unique-object
      --enable-libstdcxx-backtrace
      --enable-linker-build-id
      --enable-lto
      --disable-multilib
      --enable-plugin
      --enable-shared
      --enable-threads=posix
      --disable-libssp
      --disable-libstdcxx-pch
      --disable-werror
      --program-suffix=-16
      --enable-version-specific-runtime-libs
  )

  cd gcc-build

  # Credits @allanmcrae
  # https://github.com/allanmcrae/toolchain/blob/f18604d70c5933c31b51a320978711e4e6791cf1/gcc/PKGBUILD
  # TODO: properly deal with the build issues resulting from this
  CFLAGS=${CFLAGS/-Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-Werror=format-security/}

  "$srcdir/gcc16/configure" \
    --enable-languages=c,c++,fortran \
    --disable-bootstrap \
    "${_confflags[@]:?_confflags unset}"

  # see https://bugs.archlinux.org/task/71777 for rationale re *FLAGS handling
  make -O CFLAGS="$CFLAGS" \
          CXXFLAGS="$CXXFLAGS" \
          LDFLAGS="$LDFLAGS" \
          -j$(nproc)

  # make documentation
  make -O -C $CHOST/libstdc++-v3/doc doc-man-doxygen

  # C++26 reflection test (P2996R13)
  cat > "$srcdir/test_reflection.cpp" <<'EOF'
#include <meta>

struct S {
  int x;
  float y;
};

using namespace std::meta;
constexpr auto ctx = access_context::current();
static_assert(nonstatic_data_members_of(^^S, ctx).size() == 2);
EOF
  ./gcc/xg++ -B./gcc/ -I./$CHOST/libstdc++-v3/include -I./$CHOST/libstdc++-v3/include/x86_64-pc-linux-gnu -I"$srcdir/gcc16/libstdc++-v3/libsupc++" -std=c++26 -freflection -fsyntax-only "$srcdir/test_reflection.cpp"
}

# Disabled to reduce build time.
