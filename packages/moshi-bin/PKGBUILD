# Maintainer: xihale

pkgname=moshi-bin
pkgver=0.3.10
pkgrel=1
pkgdesc="Portable daemon + CLI that bridges AI coding agents to the Moshi mobile app"
arch=('x86_64' 'aarch64')
url="https://getmoshi.app"
license=('LicenseRef-Proprietary')
optdepends=(
  'mosh: resilient roaming connections across network changes'
  'tmux: persistent sessions as the long-lived workspace'
  'openssh: SSH transport'
)
provides=('moshi-hook' 'moshi')
conflicts=('moshi-hook' 'moshi')
options=('!strip')
install=moshi-hook.install
source_x86_64=(
  'LICENSE'
  'moshi-hook.service'
  "${pkgname}-${pkgver}-x86_64.tar.gz::https://cdn.getmoshi.app/hook/v${pkgver}/moshi-hook_Linux_x86_64.tar.gz"
)
source_aarch64=(
  'LICENSE'
  'moshi-hook.service'
  "${pkgname}-${pkgver}-aarch64.tar.gz::https://cdn.getmoshi.app/hook/v${pkgver}/moshi-hook_Linux_arm64.tar.gz"
)
sha256sums_x86_64=(
  '0e2eb8feeae72a47b3ebc80d3f44c63bc6c1f5bb35838b43691d1bce29141b58'
  '2ba8e18253cf748a3eed2ac4dcfa0c426ffba83464205babe3bcf48b031cc1cc'
  '99ff86bcb447706817e648ca4aab51fb2ebe0ccfd90e3a3910d490d582a35348'
)
sha256sums_aarch64=(
  '0e2eb8feeae72a47b3ebc80d3f44c63bc6c1f5bb35838b43691d1bce29141b58'
  '2ba8e18253cf748a3eed2ac4dcfa0c426ffba83464205babe3bcf48b031cc1cc'
  '1863e34c3f09b90b2ead9016730d6da85b3098acd106c26de000dfc362539528'
)

package() {
  install -Dm755 moshi-hook "${pkgdir}/usr/bin/moshi-hook"
  ln -s moshi-hook "${pkgdir}/usr/bin/moshi"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}/docs/" docs/*.md

  install -Dm644 moshi-hook.service "${pkgdir}/usr/lib/systemd/user/moshi-hook.service"
}
