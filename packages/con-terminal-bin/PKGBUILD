# Maintainer: Forge <forge@example.invalid>

pkgname=con-terminal-bin
pkgver=0.1.0.beta.58
pkgrel=1
pkgdesc='Native terminal emulator with built-in AI harness (prebuilt release binary)'
arch=('x86_64')
url='https://github.com/nowledge-co/con-terminal'
license=('MIT')
depends=(
  'fontconfig'
  'freetype2'
  'hicolor-icon-theme'
  'libxcb'
  'libxkbcommon-x11'
  'tree-sitter'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
provides=('con-terminal')
conflicts=('con-terminal' 'con-terminal-git')
source=(
  "con-0.1.0.beta.58-linux-x86_64.tar.gz::https://github.com/nowledge-co/con-terminal/releases/download/v0.1.0-beta.58/con-0.1.0-beta.58-linux-x86_64.tar.gz"
)
sha256sums=('SKIP')

package() {
  cd "$srcdir/con-0.1.0-beta.58-linux-x86_64"

  install -Dm755 con "$pkgdir/usr/bin/con"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 con.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/con.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/con.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=con
GenericName=Terminal Emulator
Comment=Native terminal emulator with built-in AI harness
Exec=con
Icon=con
Terminal=false
Categories=System;TerminalEmulator;Utility;
StartupWMClass=con
EOF
}
