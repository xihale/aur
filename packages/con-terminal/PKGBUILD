# Maintainer: Forge <forge@example.invalid>

options=(!lto)

pkgname=con-terminal-git
pkgver=0.1.0.beta.58.r0.g792bfc6
pkgrel=1
pkgdesc='Native terminal emulator with built-in AI harness'
arch=('x86_64' 'aarch64')
url='https://github.com/nowledge-co/con-terminal'
license=('MIT')
depends=(
  'fontconfig'
  'freetype2'
  'libxcb'
  'libxkbcommon-x11'
  'tree-sitter'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
makedepends=(
  'cargo'
  'cmake'
  'git'
  'pkgconf'
  'rust'
  'zig'
)
provides=('con-terminal')
conflicts=('con-terminal')
source=('git+https://github.com/nowledge-co/con-terminal.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/con-terminal"
  git describe --tags --long --abbrev=7 | sed -E 's/^v//; s/-/./g; s/\.([0-9]+)\.g/.r\1.g/'
}

build() {
  cd "$srcdir/con-terminal"

  local zig_bin
  zig_bin="$(command -v zig)"
  if [[ -z "$zig_bin" ]]; then
    echo 'zig not found in PATH' >&2
    return 1
  fi

  if [[ "$(zig version)" != '0.15.2' ]]; then
    echo 'Zig 0.15.2 exactly required by upstream' >&2
    return 1
  fi

  export CON_ZIG_BIN="$zig_bin"
  cargo build --release --locked -p con
}

check() {
  cd "$srcdir/con-terminal"
  cargo test --locked -p con-core -p con-cli -p con-agent -p con-terminal
}

package() {
  cd "$srcdir/con-terminal"

  install -Dm755 "target/release/con" "$pkgdir/usr/bin/con"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "assets/Con-macOS-Dark-256x256@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/con.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/con.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=con
GenericName=Terminal Emulator
Comment=Native terminal emulator with built-in AI harness
Exec=con
Icon=con
Terminal=false
Categories=System;TerminalEmulator;Utility;
StartupWMClass=con
EOF
}
